# ==========================================
# Variables de Entorno - Tetería Bodhi
# ==========================================

# Puerto para desarrollo local
PORT=3000

# ------------------------------------------
# SEGURIDAD Y AUTENTICACIÓN (OBLIGATORIAS)
# ------------------------------------------
# Contraseña de acceso al panel administrativo (no usar contraseñas por defecto)
ADMIN_PASSWORD=tu_contraseña_segura_de_administrador

# Secreto criptográfico HMAC-SHA256 para firma y validación de tokens de sesión
# Generar una cadena aleatoria de al menos 32 caracteres (ej: openssl rand -hex 32)
ADMIN_SESSION_SECRET=tu_secreto_criptografico_aleatorio_de_minimo_32_caracteres

# ------------------------------------------
# SUPABASE POSTGRESQL (PERSISTENCIA CLOUD)
# ------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública de Supabase (para lecturas públicas)
SUPABASE_ANON_KEY=tu_supabase_anon_key_publica

# Clave de servicio (Service Role) - Exclusiva del servidor para operaciones privilegiadas
# NUNCA expongas esta clave en el frontend ni en variables NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_secreta

# Conexión TCP directa opcional a PostgreSQL
# DATABASE_URL=postgres://usuario:contraseña@servidor:5432/postgres?sslmode=require

# ------------------------------------------
# CORS (ORÍGENES PERMITIDOS)
# ------------------------------------------
ALLOWED_ORIGINS=https://teteria-bodhi.vercel.app,http://localhost:3000

# ------------------------------------------
# NOTIFICACIONES DE RESERVAS (OPCIONALES)
# ------------------------------------------
# Opción A: WhatsApp automático al móvil (vía CallMeBot gratuito)
WHATSAPP_NOTIFY_PHONE=34600000000
WHATSAPP_NOTIFY_APIKEY=tu_apikey_aqui

# Opción B: Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=123456789

# Opción C: Correo Electrónico (vía Resend gratuito)
RESEND_API_KEY=re_123456789
ADMIN_EMAIL=teteriabodhi@ejemplo.com
