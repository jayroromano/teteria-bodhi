# ==========================================
# Variables de Entorno - Tetería Bodhi
# ==========================================

# Puerto para desarrollo local
PORT=3000

# Contraseña del panel de administración (por defecto: bodhi2026)
ADMIN_PASSWORD=bodhi2026

# Conexión a Base de Datos PostgreSQL (Opcional - Supabase / Neon / Vercel Postgres / Railway)
# Si no se define, el proyecto funciona con almacenamiento JSON local y persistencia en memoria
DATABASE_URL=postgres://usuario:contraseña@ep-ejemplo.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ==========================================
# NOTIFICACIONES DE RESERVAS (OPCIONALES)
# ==========================================

# Opción A: WhatsApp automático al móvil (vía CallMeBot gratuito)
WHATSAPP_NOTIFY_PHONE=34600000000
WHATSAPP_NOTIFY_APIKEY=tu_apikey_aqui

# Opción B: Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=123456789

# Opción C: Correo Electrónico (vía Resend gratuito)
RESEND_API_KEY=re_123456789
ADMIN_EMAIL=teteriabodhi@ejemplo.com
