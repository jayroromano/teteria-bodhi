# Puerto para desarrollo local
PORT=3000

# Contraseña del panel de administración (por defecto: bodhi2026)
ADMIN_PASSWORD=bodhi2026

# Conexión a Base de Datos PostgreSQL (Opcional - Supabase / Neon / Vercel Postgres / Railway)
# Si no se define, el proyecto funciona con almacenamiento JSON local y persistencia en memoria
DATABASE_URL=postgres://usuario:contraseña@ep-ejemplo.eu-central-1.aws.neon.tech/neondb?sslmode=require
